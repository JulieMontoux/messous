DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_minimum_32_chars_random_string
PORT=80
CORS_ORIGIN=https://your-domain.com
# URL publique de l'app (liens dans les e-mails, retour du connecteur bancaire)
APP_URL=https://your-domain.com
TZ=Europe/Paris

# --- E-mails (alertes d'enveloppes, rappel du dernier jour du mois) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MesSous <messous@your-domain.com>"
# Heure (locale) d'envoi du rappel de fin de mois
MONTH_END_HOUR=18

# --- Connecteur bancaire Enable Banking (optionnel, sinon import CSV) ---
# Clé privée à déposer dans ./secrets/enablebanking.pem
ENABLE_BANKING_APP_ID=
BANK_SYNC_INTERVAL_HOURS=6
